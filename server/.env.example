# Server
PORT=5050
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/crypto_ai_platform

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRE=7d

# Binance Futures Testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_WS_URL=wss://stream.binancefuture.com
BINANCE_PROXY=

# OpenAI / Gemini / Groq / CryptoCompare (for sentiment analysis)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CRYPTOCOMPARE_API_KEY=

# Risk Management Defaults
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_PORTFOLIO_DRAWDOWN=0.10
MIN_CONFIDENCE_THRESHOLD=0.60

# Trading Frequency & Limits (Configured for High-Frequency: ~1000 trades/day)
ANALYSIS_CYCLE_MS=5000
MAX_DAILY_TRADES=1000
MAX_OPEN_POSITIONS=150
MAX_CORE_POSITIONS=50
MAX_MEME_POSITIONS=50
MAX_RECOMMENDED_POSITIONS=50

# Supported Assets (comma-separated)
SUPPORTED_ASSETS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,1000SHIBUSDT,1000PEPEUSDT,WIFUSDT,1000FLOKIUSDT,1000BONKUSDT,AVAXUSDT,DOTUSDT,POLUSDT,LTCUSDT,BOMEUSDT,PEOPLEUSDT

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

